# Process listener
HOST=0.0.0.0
PORT=8080
GATEWAY_SHUTDOWN_TIMEOUT_MS=10000

# Public Supabase project identity
SUPABASE_URL=https://project-ref.supabase.co
# Defaults to ${SUPABASE_URL}/auth/v1 when omitted.
SUPABASE_ISSUER=https://project-ref.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
SUPABASE_TENANT_CLAIM=iss
SUPABASE_DEVICE_CLAIM=device_id
SUPABASE_AUTHORIZATION_RPC=authorize_realtime_session
SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets
OPENAI_API_KEY=
SAFETY_IDENTIFIER_SECRET=

# Server-owned Realtime policy
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
REALTIME_VAD_EAGERNESS=low
REALTIME_ALLOWED_TOOL_NAMES=scene_list,scene_get,retrieval_query,capture_note,capture_dictation,story_memory_suggest,changes_request,review_decide
# Optional HTTPS origins for browser callers; native mobile callers omit Origin.
GATEWAY_ALLOWED_ORIGINS=
# Optional; the built-in value restricts tools to snapshot reads and queued desktop review.
OPENAI_REALTIME_INSTRUCTIONS=

# Resource safeguards
GATEWAY_MAX_REQUEST_BYTES=65536
GATEWAY_MAX_SDP_BYTES=49152
GATEWAY_REQUEST_BODY_TIMEOUT_MS=5000
GATEWAY_OPENAI_TIMEOUT_MS=10000
GATEWAY_OPENAI_MAX_RESPONSE_BYTES=262144
GATEWAY_SUPABASE_TIMEOUT_MS=5000
GATEWAY_JWKS_TIMEOUT_MS=5000
GATEWAY_JWKS_CACHE_MAX_AGE_MS=600000
GATEWAY_RATE_LIMIT=5
GATEWAY_RATE_WINDOW_MS=60000
GATEWAY_RATE_MAX_KEYS=10000
GATEWAY_ISSUANCE_TTL_SECONDS=60
