# Independent trusted controller; do not put this token in the public gateway.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_VOICE_CONTROLLER_TOKEN=
# Same actual key/project/organization as the gateway for this binding.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORGANIZATION_ID=
# Private persistent directory, one exclusive journal per live replica.
VOICE_CONTROLLER_JOURNAL_PATH=/var/lib/openauthor-voice-controller/calls.json
VOICE_CONTROLLER_POLL_MS=1000
VOICE_CONTROLLER_CLAIM_MS=15000
VOICE_CONTROLLER_TIMEOUT_MS=5000
