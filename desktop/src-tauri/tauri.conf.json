{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openAuthor",
  "version": "0.1.0",
  "identifier": "com.openauthor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && ../scripts/verify_bundled_runtime.sh",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "openAuthor",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "resources": ["resources/runtime/python"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    }
  }
}
