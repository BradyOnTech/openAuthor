{
  "expo": {
    "name": "openAuthor",
    "slug": "openauthor-mobile",
    "scheme": "openauthor",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "openAuthor Companion",
      "shortName": "openAuthor",
      "themeColor": "#0c0d12",
      "backgroundColor": "#0c0d12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openauthor.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "openAuthor uses the microphone for foreground voice conversations you start.",
        "UIBackgroundModes": []
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.openauthor.mobile",
      "blockedPermissions": [
        "android.permission.CAMERA"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow openAuthor to unlock encrypted project keys."
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": false,
          "microphonePermission": "Allow openAuthor to use your microphone for voice conversations."
        }
      ],
      ["react-native-libsodium", {}]
    ]
  }
}
