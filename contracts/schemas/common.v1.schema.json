{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openauthor.dev/contracts/common/v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "toolName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rawSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 16384
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "maxLength": 16777216
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "channel": {
      "enum": ["text", "desktop_voice", "mobile_voice"]
    },
    "contractVersion": {
      "type": "integer",
      "const": 1
    },
    "relativeObjectKey": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"
    }
  }
}
